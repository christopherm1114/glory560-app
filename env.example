# =====================================================================
# COPIA este archivo como  .env  y rellena los valores reales.
# NUNCA subas el archivo .env a GitHub (ya está ignorado en .gitignore).
# =====================================================================

# Token que te da @BotFather al crear el bot de Telegram.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Una palabra secreta que tú inventas (ej. "glory560secreto2027").
# Sirve para que solo Telegram pueda llamar a tu webhook.
TELEGRAM_WEBHOOK_SECRET=cambia-esto-por-algo-secreto

# URL de tu proyecto Supabase (Settings -> API -> Project URL).
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clave "service_role" de Supabase (Settings -> API -> service_role secret).
# OJO: es una clave con permisos totales, mantenla privada.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx

# Tu ID numérico de Telegram (el del administrador que aprueba usuarios).
# Para saberlo, escríbele a @userinfobot en Telegram y te lo dice.
ADMIN_TELEGRAM_ID=0
